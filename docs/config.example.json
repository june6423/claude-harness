{
  "project": "<project>",
  "towers": {
    "sandbox": true,
    "models": {"dt": "fable", "et": "opus", "vt": "fable"},
    "background_model": "claude-opus-5-5"
  },
  "limits": {
    "run_tasks_per_handoff": 20,
    "full_tasks_per_handoff": 3,
    "recovery_attempts": 5,
    "messages_per_peer_per_10_minutes": 10,
    "context_rotate_tokens": 600000
  },
  "executor": {"poll_seconds": 10},
  "workspaces": {
    "<workspace key>": {
      "path": "workspace/<repo directory>",
      "remote": "https://github.com/<owner>/<repo>.git",
      "default_branch": "main",
      "experiment_branch_prefix": "exp/",
      "server_repos": ["<server repo key>"],
      "server_outputs": "/workspace/harness/outputs"
    }
  },
  "ssh": {
    "connect_timeout_seconds": 15,
    "control_persist_seconds": 120,
    "server_alive_interval_seconds": 30,
    "server_alive_count_max": 3
  },
  "servers": {
    "<server name>": {
      "transport": "ssh",
      "ssh_host": "<Host name in ~/.ssh/config>",
      "repos": {
        "<server repo key>": {
          "path": "/home/<user>/harness/<repo>",
          "containers": {
            "<container name>": {"workdir": "/workspace/harness/<repo>"}
          }
        }
      }
    }
  }
}
