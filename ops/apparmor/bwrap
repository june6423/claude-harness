# AppArmor profile for bubblewrap (Claude Code Bash sandbox).
# Ubuntu 24.04 blocks unprivileged user namespaces for programs without a
# profile (kernel.apparmor_restrict_unprivileged_userns=1). This profile
# gives that permission to /usr/bin/bwrap only. It uses the same form as the
# Ubuntu profiles for brave, 1password, and other applications.
# Install: sudo install -m 644 ops/apparmor/bwrap /etc/apparmor.d/bwrap
#          sudo apparmor_parser -r /etc/apparmor.d/bwrap

abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bwrap>
}
