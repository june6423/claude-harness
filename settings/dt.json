{
  "crossSessionInbound": "accept",
  "permissions": {
    "defaultMode": "dontAsk",
    "additionalDirectories": [
      "{{DATA_ROOT}}"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "SendMessage",
      "ListAgents",
      "Skill",
      "ToolSearch",
      "AskUserQuestion",
      "Bash(bin/harness root)",
      "Bash(bin/harness show *)",
      "Bash(bin/harness list)",
      "Bash(bin/harness list *)",
      "Bash(bin/harness message *)",
      "Bash(bin/harness messages)",
      "Bash(bin/harness messages *)",
      "Bash(bin/harness verify)",
      "Edit(/{{DATA_ROOT}}/runtime/drafts/dt/**)",
      "WebSearch",
      "WebFetch",
      "Edit(/{{DATA_ROOT}}/state/PROJECT_STATE.md)",
      "Bash(bin/harness publish handoff * --actor DT)",
      "Bash(bin/harness handoff-draft *)",
      "Bash(bin/harness status)",
      "Bash(bin/harness status *)",
      "Bash(bin/harness publish directive * --actor DT)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * status*)",
      "Bash(git -C * ls-tree*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * branch*)",
      "Bash(git -C * grep*)",
      "Edit(/{{DATA_ROOT}}/worklog/dt.md)",
      "Edit(/{{DATA_ROOT}}/worklog/dt-summary.md)",
      "Bash(bin/harness handover dt *)",
      "Bash(bin/harness grants)",
      "Bash(bin/harness grants *)",
      "Bash(bin/harness publish grant * --actor DT)",
      "Bash(bin/harness publish revoke * --actor DT)",
      "Bash(bin/harness cancel * --actor DT)",
      "Edit(/{{DATA_ROOT}}/archive/**)",
      "Bash(bin/harness archive *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(sha256sum *)",
      "Bash(md5sum *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(jq *)",
      "Bash(python3 *)",
      "Bash(bash *)",
      "Bash(nvidia-smi *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(env *)"
    ],
    "deny": [
      "Edit(/{{HARNESS}}/**)",
      "Bash(bin/harness executor *)",
      "Bash(bin/harness tower *)",
      "Bash(bin/harness init *)",
      "Bash(bin/harness --data-root *)",
      "Read(/{{DATA_ROOT}}/runtime/logs/**)",
      "Bash(bin/harness git *)",
      "Edit(/{{DATA_ROOT}}/workspace/**)",
      "Bash(git push*)",
      "Bash(git * push)",
      "Bash(git * push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "bin/harness *",
      "./bin/harness *",
      "{{HARNESS}}/bin/harness *"
    ],
    "filesystem": {
      "allowWrite": [
        "{{DATA_ROOT}}/runtime/drafts/dt",
        "{{DATA_ROOT}}/state",
        "{{DATA_ROOT}}/archive"
      ],
      "denyWrite": [
        "{{HARNESS}}"
      ],
      "denyRead": [
        "{{DATA_ROOT}}/runtime/logs"
      ]
    },
    "network": {
      "allowedDomains": [],
      "strictAllowlist": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/message_ledger.py\" --tower dt"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/dt_guard.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/dt_guard.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/message_ledger.py\" --tower dt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/context_guard.py\" --tower dt"
          }
        ]
      }
    ]
  }
}
