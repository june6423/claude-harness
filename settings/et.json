{
  "crossSessionInbound": "accept",
  "permissions": {
    "defaultMode": "dontAsk",
    "additionalDirectories": [
      "{{DATA_ROOT}}"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "SendMessage",
      "ListAgents",
      "Skill",
      "ToolSearch",
      "Bash(bin/harness root)",
      "Bash(bin/harness show *)",
      "Bash(bin/harness list)",
      "Bash(bin/harness list *)",
      "Bash(bin/harness message *)",
      "Bash(bin/harness messages)",
      "Bash(bin/harness messages *)",
      "Bash(bin/harness verify)",
      "Edit(/{{DATA_ROOT}}/runtime/drafts/et/**)",
      "Edit(/{{DATA_ROOT}}/workspace/**)",
      "Bash(git *)",
      "Bash(cd *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(chmod *)",
      "Bash(mkdir *)",
      "Bash(bin/harness publish task * --actor ET)",
      "Bash(bin/harness publish report * --actor ET)",
      "Bash(bin/harness wait *)",
      "Bash(bin/harness status)",
      "Bash(bin/harness status *)",
      "Bash(bin/harness git *)"
    ],
    "deny": [
      "Edit(/{{HARNESS}}/**)",
      "Bash(bin/harness executor *)",
      "Bash(bin/harness tower *)",
      "Bash(bin/harness init *)",
      "Bash(bin/harness --data-root *)",
      "Edit(/{{DATA_ROOT}}/state/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git * remote add *)",
      "Bash(git * remote set-url *)",
      "Bash(git * remote rename *)",
      "Bash(git * config *)",
      "Bash(git * push http*)",
      "Bash(git * push git@*)",
      "Bash(git * push ssh:*)",
      "Bash(git * push file:*)",
      "Bash(git * push /*)",
      "Bash(git * push --repo*)",
      "Bash(git * -c *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "bin/harness *"
    ],
    "filesystem": {
      "allowWrite": [
        "{{DATA_ROOT}}/runtime/drafts/et",
        "{{DATA_ROOT}}/workspace"
      ],
      "denyWrite": [
        "{{HARNESS}}"
      ],
      "denyRead": []
    },
    "network": {
      "allowedDomains": [
        "github.com"
      ],
      "strictAllowlist": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/message_ledger.py\" --tower et"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/message_ledger.py\" --tower et"
          }
        ]
      }
    ]
  }
}
